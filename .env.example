# ===== Telegram =====
# Crie o bot com o @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=
# Onde os alertas chegam: seu chat privado ou um grupo (ID de grupo começa com -)
# Com o bot rodando, mande /id no chat para descobrir
TELEGRAM_CHAT_ID=
# Seu ID de usuário (mande /id). Só esses IDs podem usar /analise, /adicionar e /remover.
# Separe vários por vírgula. Vazio = qualquer pessoa do chat pode usar tudo.
TELEGRAM_ADMIN_IDS=

# ===== IA (OpenAI) =====
# Crie em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo usado na análise (ex.: gpt-5.4-mini mais barato, gpt-5.5 mais capaz)
OPENAI_MODEL=gpt-5.4-mini
# Profundidade do raciocínio: none | minimal | low | medium | high
# Deixe vazio se o modelo escolhido não suportar raciocínio
OPENAI_REASONING_EFFORT=low
# Deixa a IA pesquisar notícias recentes na web
AI_WEB_SEARCH=true

# ===== Mercado =====
EXCHANGE=coinbase
# Lista INICIAL (só na primeira execução). Depois use /adicionar e /remover no bot
SYMBOLS=BTC/USD,ETH/USD,SOL/USD
# 15m | 30m | 1h | 2h | 6h | 1d (Coinbase não tem 4h). A IA também recebe o tempo gráfico acima (30m → 2h)
TIMEFRAME=30m
CHECK_INTERVAL_MIN=5

# ===== Regras de alerta =====
# Perfil de risco inicial: conservador | moderado | agressivo
# (depois de iniciado, troque pelo bot com /perfil; o bot guarda a escolha)
RISK_PROFILE=conservador
# Confiança mínima da IA para alertar: baixa | media | alta
# Deixe VAZIO para usar o padrão de cada perfil (conservador/moderado = media, agressivo = baixa)
MIN_CONFIDENCE=
# Por quantas horas vale um gatilho de preço (nível que dispara nova análise)
TRIGGER_TTL_HOURS=48
# Moedas sem gatilho ganham um automático (sem IA) na máxima/mínima das últimas 30 velas do tempo
# gráfico maior (30m -> 2h, ~2,5 dias). A IA só é chamada se a faixa romper. Recalculado a cada N horas.
AUTO_TRIGGERS=true
AUTO_TRIGGER_HOURS=6
# Depois de analisar um ativo, espera N velas para reanalisá-lo
COOLDOWN_CANDLES=4
# Mínimo de minutos entre análises disparadas por gatilho na mesma moeda
TRIGGER_MIN_INTERVAL_MIN=120
# Alvo mínimo de uma COMPRA = N x taxa de ida e volta (com PAPER_FEE_PCT=0.6, 2 x 1,2% = +2,4%)
MIN_TARGET_FEE_MULT=2
# Busca de notícias na web (a parte mais cara): no máximo 1 a cada N horas por moeda; /analise sempre busca
NEWS_CACHE_HOURS=6
# Teto de análises automáticas da IA por dia (0 = sem limite); /analise não conta no teto
MAX_AI_CALLS_DAY=40
# true = também avisa quando a IA descarta o sinal (bom para acompanhar no começo)
SEND_REJECTED=false

# ===== Tokens de DEX (ex.: memecoins da Solana que só existem no app da Coinbase) =====
# Se o par não existe na corretora, o /adicionar procura o token nas DEX (velas via GeckoTerminal)
DEX_ENABLED=true
DEX_MIN_VOLUME_USD=500000
# Taxa + slippage por lado ao comprar pelo app (usada no paper trading desses tokens)
DEX_FEE_PCT=2.0

# Fuso dos horários nas mensagens
TIMEZONE=America/Sao_Paulo

# ===== Paper trading (simulação) =====
PAPER_TRADE_USD=100
PAPER_FEE_PCT=0.6
