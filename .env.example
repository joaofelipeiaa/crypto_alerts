# ===== Telegram =====
# Crie o bot com o @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=
# Onde os alertas chegam: seu chat privado ou um grupo (ID de grupo começa com -)
# Com o bot rodando, mande /id no chat para descobrir
TELEGRAM_CHAT_ID=
# Seu ID de usuário (mande /id). Só esses IDs podem usar /analise, /adicionar e /remover.
# Separe vários por vírgula. Vazio = qualquer pessoa do chat pode usar tudo.
TELEGRAM_ADMIN_IDS=

# ===== IA (OpenAI) =====
# Crie em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo usado na análise (ex.: gpt-5.4-mini mais barato, gpt-5.5 mais capaz)
OPENAI_MODEL=gpt-5.4-mini
# Profundidade do raciocínio: none | minimal | low | medium | high
# Deixe vazio se o modelo escolhido não suportar raciocínio
OPENAI_REASONING_EFFORT=low
# Deixa a IA pesquisar notícias recentes na web
AI_WEB_SEARCH=true

# ===== Mercado =====
EXCHANGE=coinbase
# Lista INICIAL (só na primeira execução). Depois use /adicionar e /remover no bot
SYMBOLS=BTC/USD,ETH/USD,SOL/USD
# 15m | 1h | 4h | 1d ... (Coinbase não tem 4h nativo: use 1h, 2h, 6h ou 1d)
TIMEFRAME=1h
CHECK_INTERVAL_MIN=5

# ===== Regras de alerta =====
# Perfil de risco inicial: conservador | moderado | agressivo
# (depois de iniciado, troque pelo bot com /perfil; o bot guarda a escolha)
RISK_PROFILE=conservador
# Confiança mínima da IA para alertar: baixa | media | alta
# Deixe VAZIO para usar o padrão de cada perfil (conservador/moderado = media, agressivo = baixa)
MIN_CONFIDENCE=
# Por quantas horas vale um gatilho de preço (nível que dispara nova análise)
TRIGGER_TTL_HOURS=48
# Depois de analisar um ativo, espera N velas para reanalisá-lo
COOLDOWN_CANDLES=4
# true = também avisa quando a IA descarta o sinal (bom para acompanhar no começo)
SEND_REJECTED=false

# ===== Paper trading (simulação) =====
PAPER_TRADE_USD=100
PAPER_FEE_PCT=0.6
